{
  "name": "@zetesis/quartz-okf",
  "version": "0.1.0",
  "private": true,
  "description": "OKF for Quartz — the Quartz↔Open Knowledge Format integration: a renderer-independent contract plus Quartz plugins.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Zetesis-Labs/quartz-okf",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zetesis-Labs/quartz-okf.git"
  },
  "workspaces": [
    "core",
    "plugins/*"
  ],
  "scripts": {
    "test": "node --test \"core/test/*.test.ts\" \"harness/test/*.test.ts\" \"plugins/quartz-okf/test/*.test.ts\" \"plugins/quartz-okf-explorer/test/*.test.ts\" \"plugins/quartz-okf-panels/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @zetesis/quartz-okf -w @zetesis/quartz-okf-explorer"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "quartz",
    "okf",
    "open-knowledge-format",
    "knowledge-graph"
  ],
  "engines": {
    "node": ">=22.18"
  }
}
